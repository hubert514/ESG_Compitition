      "source": [
        "# ============================================================\n",
        "# Compute class weights for imbalanced labels\n",
        "# ============================================================\n",
        "# Idea: rare classes get larger loss weights; frequent classes get smaller weights.\n",
        "# Formula: weight = total training samples / (number of classes * class count)\n",
        "# Each task needs its own weights because the four label distributions are different.\n",
        "\n",
        "label_counts = {\n",
        "    field: Counter(sample[field] for sample in train_data)\n",
        "    for field in EVAL_FIELDS\n",
        "}\n",
        "\n",
        "class_weights = {}\n",
        "for field, labels in EVAL_FIELDS.items():\n",
        "    total = sum(label_counts[field].values())\n",
        "    num_classes_for_field = len(labels)\n",
        "\n",
        "    weights = []\n",
        "    for label in labels:\n",
        "        count = label_counts[field].get(label, 0)\n",
        "        weight = total / (num_classes_for_field * count) if count > 0 else 0.0\n",
        "        weights.append(weight)\n",
        "\n",
        "    class_weights[field] = torch.tensor(weights, dtype=torch.float, device=device)\n",
        "\n",
        "print(\"Class weights are ready.\")\n",
        "for field, labels in EVAL_FIELDS.items():\n",
        "    print(f\"\\n{field}\")\n",
        "    for label, weight in zip(labels, class_weights[field].detach().cpu().tolist()):\n",
        "        count = label_counts[field].get(label, 0)\n",
        "        print(f\"  {label:25s} count={count:4d}, weight={weight:.4f}\")\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 14,
      "metadata": {
        "id": "V3YflK6lWJ3T",
        "outputId": "48f59e84-e9c8-4d1a-f65c-bfae75cc5eb9",
