  {
   "cell_type": "markdown",
   "metadata": {
    "id": "fED0Q3hxWJKC"
   },
   "source": [
    "## Step 7: 定義訓練與評估函數\n",
    "\n",
    "### 損失函數\n",
    "我們使用 **CrossEntropyLoss**（交叉熵損失），適用於多分類問題。\n",
    "\n",
    "對於多任務，損失 = 各任務損失的加總：\n",
    "```\n",
    "total_loss = loss(promise_status) + loss(timeline) + loss(evidence_status) + loss(evidence_quality)\n",
    "```\n",
    "\n",
    "### 優化器與學習率排程\n",
    "- **AdamW**：Adam 的改進版，加入 weight decay 防止過擬合\n",
    "- **Linear Warmup + Decay**：先線性增加學習率（warmup），再線性衰減\n",
    "  - 前 10% 步數：學習率從 0 增加到 LR\n",
    "  - 後 90% 步數：學習率從 LR 線性衰減到 0\n",
    "\n",
    "### Gradient Clipping\n",
    "`clip_grad_norm_(model.parameters(), 1.0)` — 防止梯度爆炸，將梯度範數裁剪到最大為 1.0"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "weighted_loss_class_weights"
   },
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# Compute class weights for imbalanced labels\n",
    "# ============================================================\n",
    "# Idea: rare classes get larger loss weights; frequent classes get smaller weights.\n",
    "# Formula: weight = total training samples / (number of classes * class count)\n",
    "# Each task needs its own weights because the four label distributions are different.\n",
    "\n",
    "label_counts = {\n",
    "    field: Counter(sample[field] for sample in train_data)\n",
    "    for field in EVAL_FIELDS\n",
    "}\n",
    "\n",
    "class_weights = {}\n",
    "for field, labels in EVAL_FIELDS.items():\n",
    "    total = sum(label_counts[field].values())\n",
    "    num_classes_for_field = len(labels)\n",
    "\n",
    "    weights = []\n",
    "    for label in labels:\n",
    "        count = label_counts[field].get(label, 0)\n",
    "        weight = total / (num_classes_for_field * count) if count > 0 else 0.0\n",
    "        weights.append(weight)\n",
    "\n",
    "    class_weights[field] = torch.tensor(weights, dtype=torch.float, device=device)\n",
    "\n",
    "print(\"Class weights are ready.\")\n",
    "for field, labels in EVAL_FIELDS.items():\n",
    "    print(f\"\\n{field}\")\n",
    "    for label, weight in zip(labels, class_weights[field].detach().cpu().tolist()):\n",
    "        count = label_counts[field].get(label, 0)\n",
    "        print(f\"  {label:25s} count={count:4d}, weight={weight:.4f}\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {
    "id": "V3YflK6lWJ3T"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "訓練與預測函數定義完成！\n"
     ]
    }
   ],
   "source": [
    "def train_one_epoch(model, dataloader, optimizer, scheduler, device):\n",
    "    \"\"\"\n",
    "    訓練一個 epoch\n",
    "\n",
    "    Returns:\n",
    "        avg_loss: 平均損失值\n",
    "    \"\"\"\n",
    "    model.train()  # 切換到訓練模式（啟用 Dropout 等）\n",
    "    total_loss = 0\n",
    "    # Original unweighted loss: every class error has the same penalty.\n",
    "    # criterion = nn.CrossEntropyLoss()\n",
    "    # Weighted loss: rare classes have larger impact during training.\n",
    "    criteria = {\n",
    "        field: nn.CrossEntropyLoss(weight=class_weights[field])\n",
    "        for field in EVAL_FIELDS\n",
    "    } #feat:更改權重\n",
    "\n",
    "    for step, batch in enumerate(dataloader):\n",
    "        input_ids = batch[\"input_ids\"].to(device)\n",
    "        attention_mask = batch[\"attention_mask\"].to(device)\n",
    "\n",
    "        # 前向傳播\n",
    "        logits = model(input_ids, attention_mask)\n",
    "\n",
    "        # feat 計算所有任務的損失總和\n",
    "        loss = sum(\n",
    "            criteria[field](logits[field], batch[\"labels\"][field].to(device))\n",
    "            for field in EVAL_FIELDS\n",
    "        )\n",
    "\n",
    "        # 反向傳播\n",
    "        optimizer.zero_grad()    # 清除上一步的梯度\n",
    "        loss.backward()          # 計算梯度\n",
    "        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)  # 梯度裁剪\n",
    "        optimizer.step()         # 更新參數\n",
    "        scheduler.step()         # 更新學習率\n",
    "\n",
    "        total_loss += loss.item()\n",
    "\n",
    "        # 每50步顯示進度\n",
    "        if (step + 1) % 50 == 0:\n",
    "            print(f\"  Step {step+1}/{len(dataloader)}, Loss: {loss.item():.4f}\")\n",
    "\n",
    "    return total_loss / len(dataloader)\n",
    "\n",
    "\n",
    "def predict(model, dataloader, device, id2label):\n",
    "    \"\"\"\n",
    "    對資料集進行預測\n",
    "\n",
    "    Returns:\n",
    "        predictions: 每筆資料的預測結果（字典列表）\n",
    "    \"\"\"\n",
    "    model.eval()  # 切換到評估模式（關閉 Dropout）\n",
    "    predictions = []\n",
    "\n",
    "    with torch.no_grad():  # 不計算梯度，節省記憶體\n",
    "        for batch in dataloader:\n",
    "            input_ids = batch[\"input_ids\"].to(device)\n",
    "            attention_mask = batch[\"attention_mask\"].to(device)\n",
    "            logits = model(input_ids, attention_mask)\n",
    "\n",
    "            batch_size = input_ids.size(0)\n",
    "            for i in range(batch_size):\n",
    "                pred = {}\n",
    "                for field in EVAL_FIELDS:\n",
    "                    # argmax 取得最高分的類別 ID\n",
    "                    pred_id = logits[field][i].argmax().item()\n",
    "                    pred[field] = id2label[field][pred_id]\n",
    "                predictions.append(pred)\n",
    "\n",
    "    return predictions\n",
    "\n",
    "\n",
    "print(\"訓練與預測函數定義完成！\")"
   ]
  },
